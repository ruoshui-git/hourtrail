#!/usr/bin/env bash
set -Eeuo pipefail

# Independently verify a Codex task in its worktree: format, lint, types, unit
# tests (with counts compared against main), build, and E2E when the task
# touches the apps or e2e/. Build and E2E go through scripts/heavy; unit tests
# are light and run directly so they do not queue behind other projects' runs.
#
# Usage: verify NAME [--e2e|--no-e2e]     (NAME may be "." for the current checkout)
#
# Never hangs: every step has a time limit (HT_VERIFY_<STEP>_S overrides, in
# seconds) and the whole run an overall deadline (HT_VERIFY_DEADLINE_S, default
# 75 min). A timed-out step prints "TIMEOUT: <step>" and verify exits non-zero;
# hitting the overall deadline exits 124 naming the step it was in.

name=${1:?Usage: verify NAME [--e2e|--no-e2e]}
e2e=auto
[[ ${2:-} == --e2e ]] && e2e=yes
[[ ${2:-} == --no-e2e ]] && e2e=no
export PATH="$HOME/.local/bin:$PATH"
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)
repo=$(dirname -- "$common")
if [[ $name == . ]]; then dir=$(git rev-parse --show-toplevel); else dir=$repo/.worktrees/$name; fi
[[ -d $dir ]] || { echo "verify: no worktree at $dir" >&2; exit 2; }
heavy=$repo/scripts/heavy
counts=$repo/scripts/agent/lib/test-counts.mjs
fail=0
current=startup
limit() { local var="HT_VERIFY_${1}_S"; echo "${!var:-$2}"; }
deadline_s=${HT_VERIFY_DEADLINE_S:-4500}
(sleep "$deadline_s" && kill -TERM $$) >/dev/null 2>&1 &
sentinel=$!
on_deadline() {
	pkill -TERM -P $$ 2>/dev/null || true
	echo "verify: FAILED: overall deadline of $((deadline_s / 60)) min ($deadline_s s) reached during step: $current"
	exit 124
}
trap on_deadline TERM
reap() { # stop servers left in the task worktree (never the main checkout: verify .)
	[[ $name != . ]] && "$repo/scripts/agent/lib/reap-strays" "$dir"
	return 0
}
trap 'kill "$sentinel" 2>/dev/null || true; pkill -P "$sentinel" 2>/dev/null || true; reap' EXIT
step() { # step LABEL LIMIT_SECONDS COMMAND...
	local label=$1 secs=$2
	shift 2
	current=$label
	printf '== %s (limit %ss)\n' "$label" "$secs"
	local rc=0
	timeout -k 15 "$secs" bash -c 'cd "$1" && shift && "$@"' _ "$dir" "$@" || rc=$?
	if ((rc == 0)); then
		echo "   pass: $label"
	elif ((rc == 124 || rc == 137)); then
		echo "   TIMEOUT: $label did not finish within ${secs}s"
		fail=1
	else
		echo "   FAIL: $label"
		fail=1
	fi
}

# Unit tests with a JSON report per package, then a count.
unit() {
	(cd "$1" && find . -name .vitest-report.json -not -path '*/node_modules/*' -delete &&
		pnpm -r --workspace-concurrency=1 test --reporter=dot --reporter=json \
			--outputFile.json=.vitest-report.json)
}
export -f unit

step "pnpm install" "$(limit INSTALL 600)" pnpm install --frozen-lockfile --prefer-offline --reporter=silent
step "format" "$(limit FORMAT 300)" pnpm format:check
step "lint" "$(limit LINT 600)" pnpm lint
step "types" "$(limit TYPES 600)" pnpm typecheck
step "unit tests" "$(limit UNIT 900)" unit "$dir"
here_counts=$(node "$counts" "$dir")

# Baseline: test counts at the commit this task branched from (its merge base
# with main), cached per commit, so later merges to main do not look like
# removed tests.
main_sha=$(git -C "$dir" merge-base main HEAD 2>/dev/null || git -C "$repo" rev-parse main)
cache=$repo/.agent-runs/.test-counts/$main_sha
if [[ ! -f $cache && $dir != "$repo" ]]; then
	mkdir -p "$(dirname "$cache")"
	base=$(mktemp -d)
	git -C "$repo" worktree add -q --detach "$base/main" "$main_sha"
	current="baseline test counts"
	timeout -k 15 "$(limit BASELINE 1200)" bash -c 'cd "$1" && pnpm install --frozen-lockfile --prefer-offline --reporter=silent && unit "$1"' _ "$base/main" >/dev/null 2>&1 ||
		echo "   (baseline counts unavailable: install or tests failed or timed out)" 
	node "$counts" "$base/main" >"$cache" || true
	git -C "$repo" worktree remove --force "$base/main" || true
	rm -rf "$base"
fi
echo "== test counts"
node "$counts" --compare "${cache:-/dev/null}" "$dir" || fail=1

step "build" "$(limit BUILD 1200)" "$heavy" pnpm build

if [[ $e2e == auto ]]; then
	e2e=no
	if [[ -f $dir/playwright.config.ts ]] &&
		git -C "$dir" diff --name-only "$(git -C "$dir" merge-base main HEAD)" |
		cat - <(git -C "$dir" ls-files --others --exclude-standard) | grep -qE '^(apps/|e2e/)'; then
		e2e=yes
	fi
fi
if [[ $e2e == yes ]]; then step "e2e" "$(limit E2E 2400)" "$heavy" pnpm e2e; fi

if ((fail)); then echo "verify: FAILED"; exit 1; fi
echo "verify: all checks passed ($here_counts)"
