{
  "name": "hourtrail",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && stylelint \"apps/web/src/**/*.{css,svelte}\"",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "e2e": "playwright test",
    "shots": "playwright test --config playwright.shots.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "postcss-html": "2.0.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "18.0.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "41.0.0",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
