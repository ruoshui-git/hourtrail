{
  "useTabs": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte" } },
    { "files": ["*.md", "*.yml", "*.yaml", "*.json", "*.jsonc"], "options": { "useTabs": false } }
  ]
}
