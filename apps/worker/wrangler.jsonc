{
  // One Worker serves the built SPA as static assets and the API under /api/*.
  // Deploy only with `pnpm exec wrangler deploy --env <staging|production>` after `pnpm build`.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hourtrail-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "hourtrail-staging",
    },
    "production": {
      "name": "hourtrail",
    },
  },
}
