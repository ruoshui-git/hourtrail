{
  // One Worker serves the built SPA as static assets and the API under /api/*.
  // Deploy only with `pnpm exec wrangler deploy --env <staging|production>` after `pnpm build`.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hourtrail-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_ORIGIN": "https://hourtrail-staging.ruoshuim.workers.dev" },
  // Local dev and tests use a local SQLite copy of this binding.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hourtrail-staging",
      "database_id": "cd846a93-643d-48fe-a999-dfe69275b144",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "hourtrail-staging",
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": { "APP_ORIGIN": "https://hourtrail-staging.ruoshuim.workers.dev" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hourtrail-staging",
          "database_id": "cd846a93-643d-48fe-a999-dfe69275b144",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "hourtrail",
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": { "APP_ORIGIN": "https://hourtrail.ruoshuim.workers.dev" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hourtrail-production",
          "database_id": "e22627b5-7a3d-4c7c-9def-522f49648e17",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
